{
  "name": "mcp-ory-kratos",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for Ory Kratos Admin API",
  "main": "./dist/index.js",
  "bin": {
    "mcp-ory-kratos": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run bun.build.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:verbose": "vitest run --config tests/vitest.config.ts --reporter=verbose"
  },
  "keywords": [
    "mcp",
    "ory",
    "kratos",
    "identity",
    "authentication"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feedback-loop-ai/mcp-ory-kratos"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@ory/kratos-client": "^26.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "^1.3.6",
    "@vitest/coverage-v8": "^4.0.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
