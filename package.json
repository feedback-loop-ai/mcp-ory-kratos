{
  "name": "mcp-ory-kratos",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for Ory Kratos Admin API",
  "bin": {
    "mcp-ory-kratos": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run bun.build.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:verbose": "vitest run --config tests/vitest.config.ts --reporter=verbose",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:unit": "vitest run --config tests/vitest.config.ts --dir tests/unit --coverage.enabled",
    "test:api": "vitest run --config tests/vitest.config.ts --dir tests/api",
    "prepublishOnly": "bun run build",
    "audit": "bun audit --audit-level=high"
  },
  "keywords": [
    "mcp",
    "ory",
    "kratos",
    "identity",
    "authentication"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feedback-loop-ai/mcp-ory-kratos"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ory/kratos-client": "^26.2.0",
    "axios": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@vitest/coverage-v8": "^4",
    "typescript": "^5.9",
    "vitest": "^4"
  },
  "overrides": {
    "axios": "^1.20.0",
    "@hono/node-server": ">=1.19.10",
    "fast-uri": ">=3.1.6",
    "nanoid": ">=3.3.16",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "rollup": ">=4.59.0",
    "ajv": ">=8.18.0",
    "body-parser": ">=2.3.0",
    "hono": ">=4.12.18",
    "postcss": ">=8.5.23",
    "qs": ">=6.16.0",
    "vite": ">=7.3.5"
  },
  "packageManager": "bun@1.3.3"
}
